<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VelaShell.ViewModels"
             xmlns:pc="using:VelaShell.Controls.Controls"
             xmlns:loc="using:VelaShell.Localization"
             x:Class="VelaShell.Views.Settings.SharedCredentialsPage"
             x:DataType="vm:SettingsViewModel">

  <!-- 共享凭据(#550):多条连接共用的一套账号与密码 / 密钥。版式照「密钥管理」页:工具栏 + 表格 + 说明。
       操作当场生效,不等设置窗口的「保存」—— 凭据存在自己的集合里,不是设置的一部分。 -->
  <StackPanel Spacing="14">
    <StackPanel Spacing="2">
      <TextBlock Classes="page-title" Text="{loc:Localize SetCred_Title}" />
      <TextBlock Classes="page-subtitle" Text="{loc:Localize SetCred_Subtitle}" />
    </StackPanel>

    <!-- 工具栏 -->
    <Grid ColumnDefinitions="220,*,Auto">
      <TextBox Grid.Column="0" Text="{Binding SharedCredentials.SearchQuery}"
               PlaceholderText="{loc:Localize SetCred_SearchPlaceholder}"
               AutomationProperties.Name="{loc:Localize SetCred_SearchPlaceholder}" />
      <Button Grid.Column="2" Classes="dlg-primary"
              IsEnabled="{Binding SharedCredentials.IsAvailable}"
              AutomationProperties.Name="{loc:Localize SetCred_New}"
              Click="New_Click">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.plus}"
                         Foreground="{Binding $parent[Button].Foreground}" />
          <TextBlock Text="{loc:Localize SetCred_New}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- 凭据表格 -->
    <Border Classes="table">
      <StackPanel>
        <!-- 表头 -->
        <Border Height="36" Background="{DynamicResource VelaBgSidebar}"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1"
                Padding="12,0">
          <Grid ColumnDefinitions="*,120,90,90,60">
            <TextBlock Text="{loc:Localize Name}" Foreground="{DynamicResource VelaTextMuted}" FontSize="{DynamicResource VelaFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{loc:Localize Username}" Foreground="{DynamicResource VelaTextMuted}" FontSize="{DynamicResource VelaFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{loc:Localize AuthMethodLabel}" Foreground="{DynamicResource VelaTextMuted}" FontSize="{DynamicResource VelaFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{loc:Localize SetCred_ColUsage}" Foreground="{DynamicResource VelaTextMuted}" FontSize="{DynamicResource VelaFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{loc:Localize SetSync_Actions}" Foreground="{DynamicResource VelaTextMuted}" FontSize="{DynamicResource VelaFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding SharedCredentials.FilteredItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SharedCredentialRow">
              <Border Height="40" Padding="12,0"
                      BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,120,90,90,60">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <pc:LucideIcon Width="13" Height="13"
                                   Data="{StaticResource Icon.key-round}"
                                   Foreground="{DynamicResource VelaAccent}" />
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource VelaTextPrimary}"
                               FontSize="{DynamicResource VelaFontSize12}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <!-- 本机缺密码 / 密钥(多半是云同步没开端到端口令拉下来的):现在就提醒,别等连接时才发现。 -->
                    <pc:LucideIcon Width="12" Height="12" IsVisible="{Binding MissingSecret}"
                                   Data="{StaticResource Icon.triangle-alert}"
                                   Foreground="{DynamicResource VelaWarning}"
                                   ToolTip.Tip="{loc:Localize SetCred_MissingSecretTip}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding UsernameText}"
                             Foreground="{DynamicResource VelaTextSecondary}"
                             FontFamily="{DynamicResource VelaUiMonoFont}" FontSize="{DynamicResource VelaFontSize11}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding AuthText}"
                             Foreground="{DynamicResource VelaTextSecondary}"
                             FontSize="{DynamicResource VelaFontSize11}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding UsageText}"
                             Foreground="{DynamicResource VelaTextMuted}"
                             FontSize="{DynamicResource VelaFontSize11}"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Width="24" Height="24" Padding="0" Background="Transparent"
                            CornerRadius="3" Cursor="Hand"
                            ToolTip.Tip="{loc:Localize SetCred_Edit}"
                            AutomationProperties.Name="{loc:Localize SetCred_Edit}"
                            Click="Edit_Click">
                      <pc:LucideIcon Width="13" Height="13"
                                     Data="{StaticResource Icon.pencil}"
                                     Foreground="{DynamicResource VelaTextTertiary}" />
                    </Button>
                    <!-- 删之前先确认,并说清楚在用它的连接会怎样(各自留一份同样的凭据,照样能连)。 -->
                    <Button Width="24" Height="24" Padding="0" Background="Transparent"
                            CornerRadius="3" Cursor="Hand"
                            ToolTip.Tip="{loc:Localize SetCred_Delete}"
                            AutomationProperties.Name="{loc:Localize SetCred_Delete}"
                            Click="Delete_Click">
                      <pc:LucideIcon Width="13" Height="13"
                                     Data="{StaticResource Icon.trash-2}"
                                     Foreground="{DynamicResource VelaTextTertiary}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空状态:第一次来这一页的人要知道这东西是干什么的、怎么用。 -->
        <TextBlock Margin="12,14" Classes="row-desc"
                   IsVisible="{Binding SharedCredentials.IsEmpty}"
                   Text="{loc:Localize SetCred_Empty}" />
      </StackPanel>
    </Border>

    <!-- 提示 -->
    <StackPanel Orientation="Horizontal" Spacing="6">
      <PathIcon Width="12" Height="12"
                Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                Foreground="{DynamicResource VelaTextMuted}" VerticalAlignment="Top" Margin="0,2,0,0" />
      <TextBlock Classes="row-desc" Text="{loc:Localize SetCred_StorageHint}" MaxWidth="640" />
    </StackPanel>
    <TextBlock Classes="row-desc"
               Text="{Binding SharedCredentials.StatusMessage}"
               IsVisible="{Binding SharedCredentials.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
