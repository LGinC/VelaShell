<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VelaShell.ViewModels"
             xmlns:pc="using:VelaShell.Controls.Controls"
             xmlns:ctl="using:VelaShell.Controls"
             xmlns:loc="using:VelaShell.Localization"
             x:Class="VelaShell.Views.Settings.ShortcutsPage"
             x:DataType="vm:SettingsViewModel">

  <!-- 快捷键页:条目全部来自 ShortcutCatalog,与 velashell-docs 的快捷键参考同源;这里不放任何写死的键位。
       带编辑按钮的那些是可自定义键位(出厂表在 Services/ShortcutKeymap.cs 的 ShortcutBindings):
       改键、解绑、恢复默认都只改暂存的设置,保存设置后主窗口按新键位表重建 KeyBindings。 -->

  <UserControl.Styles>
    <!-- 分组头:与代码片段页、侧栏快捷命令面板同款——压掉 Fluent ToggleButton 的强调色
         选中态,展开状态只由箭头表达;底色沿用设置页表头的 VelaBgSidebar。 -->
    <Style Selector="ToggleButton.group-header">
      <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.group-header /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
    </Style>
    <Style Selector="ToggleButton.group-header:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
    </Style>
    <Style Selector="ToggleButton.group-header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="ToggleButton.group-header:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="ToggleButton.group-header:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
    </Style>

    <!-- 行内操作:24×24 透明图标按钮(代码片段页、密钥管理页同款)。 -->
    <Style Selector="Button.icon-btn">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.icon-btn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>

    <!-- 终端冲突提示与录键反馈的颜色。必须走样式:带类名的样式按「样式触发」优先级生效,
         会压过数据模板里直接写在 TextBlock 上的 Foreground(设置窗口的 row-desc 就是这样把它们刷成灰色的)。 -->
    <Style Selector="TextBlock.row-desc.warn">
      <Setter Property="Foreground" Value="{DynamicResource VelaWarning}" />
    </Style>
    <Style Selector="TextBlock.row-desc.error">
      <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
    </Style>

    <!-- 键帽文字:改过的键位用强调色,一眼看出哪几条不是出厂值。 -->
    <Style Selector="ItemsControl.keys TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
    </Style>
    <Style Selector="ItemsControl.keys.customized TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccentText}" />
    </Style>

    <!-- 录键框:输入框底色 + 强调色描边,与取色器展开时的描边同一语言。 -->
    <Style Selector="ctl|ShortcutRecorder">
      <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="MaxWidth" Value="220" />
    </Style>
    <Style Selector="ctl|ShortcutRecorder TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccentText}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14">
    <StackPanel Spacing="2">
      <TextBlock Classes="page-title" Text="{loc:Localize SetShortcuts_Title}" />
      <TextBlock Classes="page-subtitle" Text="{loc:Localize SetShortcuts_Subtitle}" />
    </StackPanel>

    <!-- 改键说明:怎么改、解绑意味着什么、何时生效。 -->
    <TextBlock Classes="row-desc" Text="{loc:Localize Sc_EditHint}" />

    <!-- 搜索:动作名、键位与生效条件一起匹配(ShortcutItem.SearchText)。
         命中的分组会被临时展开,搜索清空后还原用户原本的折叠态。 -->
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
      <TextBox Text="{Binding ShortcutFilter}"
               PlaceholderText="{loc:Localize Sc_FilterPlaceholder}" />
      <TextBlock Grid.Column="1" Classes="row-desc"
                 Text="{Binding ShortcutCountText}"
                 TextWrapping="NoWrap" VerticalAlignment="Center" />
      <Button Grid.Column="2" Theme="{StaticResource VelaOutlineButtonTheme}"
              Content="{loc:Localize Sc_ResetAll}"
              IsVisible="{Binding HasCustomShortcuts}"
              Click="ResetAllShortcuts_Click" />
    </Grid>

    <TextBlock Classes="row-desc" IsVisible="{Binding !HasShortcutMatches}"
               Text="{loc:Localize Sc_NoMatch}" />

    <ItemsControl ItemsSource="{Binding FilteredShortcutGroups}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ShortcutGroup">
          <Border Classes="table">
            <StackPanel>
              <!-- 组名在内层 TextBlock 上,读屏器读不到按钮本身;显式给个名字。 -->
              <ToggleButton Classes="group-header"
                            AutomationProperties.Name="{Binding Title}"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                <Grid ColumnDefinitions="Auto,8,*,Auto">
                  <Panel Width="11" Height="11" VerticalAlignment="Center">
                    <pc:LucideIcon Width="11" Height="11"
                                   Data="{StaticResource Icon.chevron-right}"
                                   Foreground="{DynamicResource VelaTextTertiary}"
                                   IsVisible="{Binding !IsExpanded}" />
                    <pc:LucideIcon Width="11" Height="11"
                                   Data="{StaticResource Icon.chevron-down}"
                                   Foreground="{DynamicResource VelaTextTertiary}"
                                   IsVisible="{Binding IsExpanded}" />
                  </Panel>
                  <TextBlock Grid.Column="2" Text="{Binding Title}"
                             Foreground="{DynamicResource VelaTextSecondary}"
                             FontSize="{DynamicResource VelaFontSize12}" FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <!-- 计数徽标:折叠后仍能一眼看出这组里有几条,不必展开确认。 -->
                  <Border Grid.Column="3" Padding="6,1" CornerRadius="8"
                          Background="{DynamicResource VelaBgInput}"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilteredItems.Count}"
                               Foreground="{DynamicResource VelaTextMuted}"
                               FontSize="{DynamicResource VelaFontSize10}" />
                  </Border>
                </Grid>
              </ToggleButton>

              <ItemsControl ItemsSource="{Binding FilteredItems}"
                            IsVisible="{Binding IsExpanded}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShortcutItem">
                    <!-- 行高自适应:带生效条件、终端冲突提示或录键反馈的条目要在动作名下面多排几行,
                         写死 36px 会把它们裁掉。分隔线画在上边框,免得最后一行与分组框重线。 -->
                    <Border MinHeight="36" Padding="12,7"
                            BorderBrush="{DynamicResource VelaBorderPrimary}"
                            BorderThickness="0,1,0,0">
                      <!-- 第三列给行内按钮留出固定宽度,固定键位的行也留着,同一组里键帽才对得齐。 -->
                      <Grid ColumnDefinitions="*,Auto,78" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Label}"
                                     Foreground="{DynamicResource VelaTextSecondary}"
                                     FontSize="{DynamicResource VelaFontSize12}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="row-desc"
                                     IsVisible="{Binding HasNote}"
                                     Text="{Binding Note}" />
                          <!-- 当前键位会从终端手里抢走一个按键(如 ^W):提示可以解绑,或者有别的按法。 -->
                          <TextBlock Classes="row-desc warn"
                                     IsVisible="{Binding HasWarning}"
                                     Text="{Binding Warning}" />
                          <!-- 录键反馈:被拒的原因,或与谁冲突。冲突时跟一组「替换 / 取消」。 -->
                          <TextBlock Classes="row-desc error"
                                     IsVisible="{Binding HasMessage}"
                                     Text="{Binding Message}" />
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0"
                                      IsVisible="{Binding HasPendingReplace}">
                            <Button Theme="{StaticResource VelaAccentPillButtonTheme}" Height="26"
                                    Padding="12,0"
                                    Content="{loc:Localize Sc_Replace}"
                                    Click="ConfirmReplace_Click" />
                            <Button Theme="{StaticResource VelaOutlineButtonTheme}" Height="26"
                                    Content="{loc:Localize Cancel}"
                                    Click="CancelRecording_Click" />
                          </StackPanel>
                        </StackPanel>

                        <Panel Grid.Column="1" VerticalAlignment="Center">
                          <ItemsControl Classes="keys"
                                        Classes.customized="{Binding IsCustomized}"
                                        ItemsSource="{Binding Keys}"
                                        IsVisible="{Binding HasKeys}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <Border Classes="keycap">
                                  <TextBlock Text="{Binding}"
                                             FontFamily="{DynamicResource VelaUiMonoFont}"
                                             FontSize="{DynamicResource VelaFontSize10}" FontWeight="Medium" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Classes="row-desc"
                                     IsVisible="{Binding ShowsUnbound}"
                                     Text="{loc:Localize Sc_Unbound}"
                                     VerticalAlignment="Center" />
                          <ctl:ShortcutRecorder IsVisible="{Binding IsRecording}"
                                                Prompt="{loc:Localize Sc_RecordPrompt}"
                                                AutomationProperties.Name="{loc:Localize Sc_RecordPrompt}"
                                                GestureCaptured="Recorder_GestureCaptured"
                                                Cancelled="Recorder_Cancelled" />
                        </Panel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    IsVisible="{Binding IsEditable}">
                          <Button Classes="icon-btn"
                                  ToolTip.Tip="{loc:Localize Sc_EditShortcut}"
                                  AutomationProperties.Name="{loc:Localize Sc_EditShortcut}"
                                  Click="RecordShortcut_Click">
                            <pc:LucideIcon Width="13" Height="13"
                                           Data="{StaticResource Icon.pencil}"
                                           Foreground="{DynamicResource VelaTextTertiary}" />
                          </Button>
                          <Button Classes="icon-btn"
                                  ToolTip.Tip="{loc:Localize Sc_UnbindShortcut}"
                                  AutomationProperties.Name="{loc:Localize Sc_UnbindShortcut}"
                                  IsVisible="{Binding !IsUnbound}"
                                  Click="UnbindShortcut_Click">
                            <pc:LucideIcon Width="13" Height="13"
                                           Data="{StaticResource Icon.x}"
                                           Foreground="{DynamicResource VelaTextTertiary}" />
                          </Button>
                          <Button Classes="icon-btn"
                                  ToolTip.Tip="{loc:Localize Sc_ResetShortcut}"
                                  AutomationProperties.Name="{loc:Localize Sc_ResetShortcut}"
                                  IsVisible="{Binding IsCustomized}"
                                  Click="ResetShortcut_Click">
                            <pc:LucideIcon Width="13" Height="13"
                                           Data="{StaticResource Icon.rotate-ccw}"
                                           Foreground="{DynamicResource VelaTextTertiary}" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 平台差异:表里统一列 Ctrl,macOS 上终端内另有一组 Command 别名
         (KeyboardShortcutService),在这里说清。 -->
    <TextBlock Classes="row-desc" Text="{Binding ShortcutMacNote}" />
  </StackPanel>
</UserControl>
