<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:VelaShell.ViewModels"
        xmlns:models="using:VelaShell.Core.Models"
        xmlns:behaviors="using:VelaShell.Behaviors"
        xmlns:pc="using:VelaShell.Controls.Controls"
        xmlns:loc="using:VelaShell.Localization"
        mc:Ignorable="d" d:DesignWidth="560"
        x:Class="VelaShell.Views.SharedCredentialEditorView"
        x:DataType="vm:SharedCredentialEditorViewModel"
        Title="{Binding Title}"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <!-- 共享凭据(#550)的新建 / 编辑框。外壳与登录框同一规格(bg-surface 卡片、28px 标题栏 + 52px 按钮栏);
       动作按钮按 DESIGN.md §5.1 走两套共享主题。上半是凭据本身,下半是「哪些连接用它」——
       这个功能的用法就是两步连着做:建一条凭据,再把一批连接挂上去。 -->

  <Window.Styles>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style Selector="TextBlock.field-error">
      <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.field-hint">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- 认证方式分段选择(同登录框):顺序同 AuthMethod 的枚举值。 -->
    <Style Selector="Button.seg-tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Height" Value="26" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.seg-tab.active">
      <Setter Property="Background" Value="{DynamicResource VelaAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaAccentForeground}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
  </Window.Styles>

  <Border Classes="window-card"
          Background="{DynamicResource VelaBgSurface}"
          BorderBrush="{DynamicResource VelaBorderSecondary}"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,52">

      <!-- 标题栏(可拖动) -->
      <Border Grid.Row="0" Classes="window-titlebar" Padding="20,0"
              Background="Transparent"
              PointerPressed="Header_PointerPressed"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <pc:LucideIcon Width="15" Height="15"
                         Data="{DynamicResource Icon.key-round}"
                         Foreground="{DynamicResource VelaAccent}"
                         VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding Title}"
                     Foreground="{DynamicResource VelaTextPrimary}"
                     FontSize="{DynamicResource VelaFontSize13}" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Button Grid.Column="2" Width="24" Height="24"
                  Background="Transparent" Padding="0" CornerRadius="3"
                  Cursor="Hand" Command="{Binding CancelCommand}"
                  AutomationProperties.Name="{loc:Localize Cancel}"
                  VerticalAlignment="Center">
            <pc:LucideIcon Width="13" Height="13"
                           Data="{DynamicResource Icon.x}"
                           Foreground="{DynamicResource VelaTextTertiary}" />
          </Button>
        </Grid>
      </Border>

      <!-- 内容区 -->
      <StackPanel Grid.Row="1" Margin="20,16" Spacing="14">

        <!-- 从连接复制:把已有连接身上那一份凭据搬过来,不必再输一遍。 -->
        <StackPanel IsVisible="{Binding HasCopySources}">
          <TextBlock Classes="field-label" Text="{loc:Localize SharedCred_CopyFrom}" />
          <ComboBox HorizontalAlignment="Stretch"
                    ItemsSource="{Binding CopySources}"
                    SelectedItem="{Binding SelectedCopySource}"
                    PlaceholderText="{loc:Localize SharedCred_CopyFromPlaceholder}"
                    AutomationProperties.Name="{loc:Localize SharedCred_CopyFrom}" />
        </StackPanel>

        <!-- 名称 + 用户名 -->
        <Grid ColumnDefinitions="*,12,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="field-label" Text="{loc:Localize SharedCred_Name}" />
            <TextBox Text="{Binding Name}" PlaceholderText="{loc:Localize SharedCred_NamePlaceholder}" />
            <TextBlock Classes="field-error" Text="{Binding NameError}"
                       IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="field-label" Text="{loc:Localize Username}" />
            <TextBox Text="{Binding Username}" PlaceholderText="{loc:Localize SharedCred_UsernamePlaceholder}" />
          </StackPanel>
        </Grid>

        <!-- 认证方式 -->
        <StackPanel>
          <TextBlock Classes="field-label" Text="{loc:Localize AuthMethodLabel}" />
          <Border Background="{DynamicResource VelaBgInput}" CornerRadius="4" Padding="2" Height="30">
            <UniformGrid Rows="1">
              <Button Classes="seg-tab" Classes.active="{Binding IsPasswordAuth}"
                      Command="{Binding SelectAuthMethodCommand}"
                      CommandParameter="{x:Static models:AuthMethod.Password}"
                      Content="{loc:Localize Profile_PasswordAuth}" />
              <Button Classes="seg-tab" Classes.active="{Binding IsKeyAuth}"
                      Command="{Binding SelectAuthMethodCommand}"
                      CommandParameter="{x:Static models:AuthMethod.PrivateKey}"
                      Content="{loc:Localize Profile_KeyAuth}" />
              <Button Classes="seg-tab" Classes.active="{Binding IsCertAuth}"
                      Command="{Binding SelectAuthMethodCommand}"
                      CommandParameter="{x:Static models:AuthMethod.Certificate}"
                      Content="{loc:Localize Profile_CertAuth}" />
              <Button Classes="seg-tab" Classes.active="{Binding IsAgentAuth}"
                      Command="{Binding SelectAuthMethodCommand}"
                      CommandParameter="{x:Static models:AuthMethod.Agent}"
                      Content="{loc:Localize Profile_AgentAuth}" />
            </UniformGrid>
          </Border>
        </StackPanel>

        <!-- 密码 -->
        <StackPanel IsVisible="{Binding IsPasswordAuth}">
          <TextBlock Classes="field-label" Text="{loc:Localize Password}" />
          <Border Classes="input-affix">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       behaviors:SecurePasswordBox.Enabled="True"
                       behaviors:EnglishInputLocale.Enabled="True"
                       behaviors:SecurePasswordBox.Password="{Binding Password}"
                       behaviors:SecurePasswordBox.Reveal="{Binding ShowPassword}"
                       AutomationProperties.Name="{loc:Localize Password}"
                       Padding="10,0,0,0"
                       VerticalAlignment="Center" />
              <Button Grid.Column="1" Width="28" Height="28"
                      Margin="0,0,2,0" Padding="0"
                      Background="Transparent" CornerRadius="3" Cursor="Hand"
                      Command="{Binding TogglePasswordVisibilityCommand}"
                      ToolTip.Tip="{loc:Localize Profile_ShowHidePassword}"
                      AutomationProperties.Name="{loc:Localize Profile_ShowHidePassword}"
                      VerticalAlignment="Center">
                <pc:LucideIcon Width="13" Height="13"
                               Data="{StaticResource Icon.eye}"
                               Foreground="{DynamicResource VelaTextTertiary}" />
              </Button>
            </Grid>
          </Border>
        </StackPanel>

        <!-- 私钥 / 证书:证书认证就是私钥认证再加一个证书文件,共用一块面板(同连接配置页)。 -->
        <StackPanel IsVisible="{Binding ShowsPrivateKeyFields}" Spacing="12">
          <StackPanel IsVisible="{Binding IsCertAuth}">
            <TextBlock Classes="field-label" Text="{loc:Localize Profile_CertificateFile}" />
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox Grid.Column="0" Text="{Binding CertificatePath}"
                       PlaceholderText="~/.ssh/id_ed25519-cert.pub" />
              <Button Grid.Column="2" Theme="{DynamicResource VelaOutlineButtonTheme}" Height="32"
                      Content="{loc:Localize BrowseKeyFile}" Click="BrowseCertificateFile_Click" />
            </Grid>
          </StackPanel>
          <Grid ColumnDefinitions="*,12,168">
            <StackPanel Grid.Column="0">
              <TextBlock Classes="field-label" Text="{loc:Localize Profile_PrivateKeyFile}" />
              <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Grid.Column="0" Text="{Binding PrivateKeyPath}"
                         PlaceholderText="~/.ssh/id_ed25519" />
                <Button Grid.Column="2" Theme="{DynamicResource VelaOutlineButtonTheme}" Height="32"
                        Content="{loc:Localize BrowseKeyFile}" Click="BrowseKeyFile_Click" />
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="field-label" Text="{loc:Localize Profile_PassphraseOptional}" />
              <TextBox Text="{Binding PrivateKeyPassphrase}"
                       behaviors:EnglishInputLocale.Enabled="True"
                       PasswordChar="&#x2022;" RevealPassword="False" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <TextBlock Classes="field-hint" IsVisible="{Binding IsAgentAuth}"
                   Text="{loc:Localize Profile_AgentAuthHint}" />
        <TextBlock Classes="field-error" Text="{Binding SecretError}" Margin="0,-8,0,0"
                   IsVisible="{Binding SecretError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- 备注 -->
        <StackPanel>
          <TextBlock Classes="field-label" Text="{loc:Localize SharedCred_Notes}" />
          <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="44" MaxHeight="88" VerticalContentAlignment="Top" Padding="10,7" />
        </StackPanel>

        <!-- 使用这条凭据的连接 -->
        <StackPanel IsVisible="{Binding ShowUsers}" Spacing="8">
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBlock Text="{loc:Localize SharedCred_UsersTitle}"
                       Foreground="{DynamicResource VelaTextPrimary}"
                       FontSize="{DynamicResource VelaFontSize12}" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2" Theme="{DynamicResource VelaOutlineButtonTheme}"
                    Content="{loc:Localize SharedCred_CheckMatching}"
                    ToolTip.Tip="{loc:Localize SharedCred_CheckMatchingTip}"
                    Command="{Binding CheckMatchingCommand}" />
          </Grid>
          <TextBox Text="{Binding FilterText}" PlaceholderText="{loc:Localize SharedCred_FilterPlaceholder}"
                   AutomationProperties.Name="{loc:Localize SharedCred_FilterPlaceholder}" />
          <Border Background="{DynamicResource VelaBgInput}"
                  BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="1"
                  CornerRadius="4" Padding="4">
            <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Users}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SharedCredentialUserItem">
                    <CheckBox IsChecked="{Binding IsChecked}"
                              IsEnabled="{Binding IsCompatible}"
                              IsVisible="{Binding IsVisible}"
                              ToolTip.Tip="{Binding Detail}"
                              Padding="6,0,0,0" Margin="4,1">
                      <Grid ColumnDefinitions="Auto,10,*">
                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                   Foreground="{DynamicResource VelaTextPrimary}"
                                   FontSize="{DynamicResource VelaFontSize12}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                   Foreground="{DynamicResource VelaTextMuted}"
                                   FontFamily="{DynamicResource VelaUiMonoFont}"
                                   FontSize="{DynamicResource VelaFontSize10}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Classes="field-hint" Text="{Binding UsersSummary}" />
            <TextBlock Grid.Column="1" Classes="field-hint" Text="{Binding MatchStatus}" Margin="12,0,0,0"
                       IsVisible="{Binding MatchStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </Grid>
        </StackPanel>
      </StackPanel>

      <!-- 按钮栏:取消 / 保存 -->
      <Border Grid.Row="2" Padding="20,0"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="CancelButton"
                  Theme="{DynamicResource VelaOutlineButtonTheme}"
                  IsCancel="True"
                  Content="{loc:Localize Cancel}"
                  Command="{Binding CancelCommand}" />
          <Button x:Name="SaveButton"
                  Theme="{DynamicResource VelaAccentPillButtonTheme}"
                  Height="28"
                  Content="{loc:Localize Save}"
                  Command="{Binding SaveCommand}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
